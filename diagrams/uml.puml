' Relaciones Estructurales
OperacionesCL2 <|.. Lista0DLinkedL
OperacionesCL3 <|.. Lista1DLinkedL
OperacionesCL4 <|.. Lista2DLinkedL

Lista0DLinkedL <|-- Lista1DLinkedL
Lista0DLinkedL <|-- Lista2DLinkedL

Lista1DLinkedL <|-- ListaCancion
Lista1DLinkedL <|-- ListaArchivos
Lista1DLinkedL <|-- ListaIndices
Lista2DLinkedL <|-- ListaCancionOrdenada

CriterioOrdenacion <|.. PorNombre
CriterioOrdenacion <|.. PorArtista
CriterioOrdenacion <|.. PorAnio

' Relaciones de Asociación y Uso
ListaCancion "1" o-- "*" Cancion : contiene
ListaCancionOrdenada "1" o-- "1" CriterioOrdenacion : delega orden
NodoDoble "1" o-- "1" Cancion : envuelve
Lista0DLinkedL "1" o-- "*" NodoDoble : contiene

MainController ..|> ReproductorListener
MainController "1" o-- "1" TocadiscosController : orquesta
MainController "1" o-- "1" ControlesController : orquesta
MainController "1" o-- "1" PlaylistController : orquesta
MainController "1" o-- "1" SvgController : orquesta
MainController "1" o-- "1" ReproductorDeAudio : usa
MainController "1" o-- "1" ShuffleManager : usa
MainController "1" o-- "1" NodoDoble : reproduce
MainController ..> ThemeManager : usa
MainController ..> PlaceholderGenerator : usa

PlaylistController "1" o-- "1" MainController : interactúa
PlaylistController "1" o-- "1" FileImportService : importa
PlaylistController "1" o-- "1" ListaCancion : gestiona
PlaylistController ..> CancionListCell : crea
PlaylistController ..> DeleteSongsDialog : abre

ControlesController "1" o-- "1" ReproductorListener : notifica eventos
CancionListCell "1" o-- "1" MainController : callback
DeleteSongsDialog ..> MainController : notifica eliminación

ExtractorPaleta ..> Paleta : genera
MainController ..> Paleta : aplica

@enduml
